# ---------------------------------------------------------------------------
# BusinessFlow Agent — example configuration
#
# Copy to .env and fill in. Use TEST MODE credentials only.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Stripe (TEST MODE: sk_test_...). Never commit a live key.
STRIPE_API_KEY=sk_test_replace_me

# Optional: scope every Stripe read to a test clock. Set automatically by
# `python -m demo.seed_test_data`, which needs it because a fresh test account
# cannot be given overdue invoices any other way. Leave empty for normal use.
STRIPE_TEST_CLOCK=

# Slack incoming webhook for the finance channel.
# Slack app -> Incoming Webhooks -> Add New Webhook -> copy the URL.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/me
SLACK_FINANCE_CHANNEL=#finance

# LLM used by the agent loop (any OpenAI-compatible endpoint).
# Bedrock users: leave these blank and configure the Bedrock path instead.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# MCP server
MCP_HTTP=1
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_URL=http://127.0.0.1:8000/mcp

# Web demo
WEB_PORT=8080

# AWS (optional — AWS Builder mini challenge)
AWS_REGION=us-east-1

# Agent backend: "openai" (default) or "bedrock".
LLM_PROVIDER=openai

# Bedrock settings (only used when LLM_PROVIDER=bedrock).
# Put the credentials file inside the repo, e.g. ./.aws/credentials, and point
# AWS_SHARED_CREDENTIALS_FILE at it. .aws/ is git-ignored — never commit it.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_PROFILE=
AWS_SHARED_CREDENTIALS_FILE=
