# ---------------------------------------------------------------------------
# BusinessFlow Agent — example configuration
#
# Copy to .env and fill in. Use TEST MODE credentials only.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Stripe (TEST MODE: sk_test_...). Never commit a live key.
STRIPE_API_KEY=sk_test_replace_me

# Slack incoming webhook for the finance channel.
# Slack app -> Incoming Webhooks -> Add New Webhook -> copy the URL.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/me
SLACK_FINANCE_CHANNEL=#finance

# LLM used by the agent loop (any OpenAI-compatible endpoint).
# Bedrock users: leave these blank and configure the Bedrock path instead.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# MCP server
MCP_HTTP=1
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_URL=http://127.0.0.1:8000/mcp

# Web demo
WEB_PORT=8080

# AWS (optional — AWS Builder mini challenge)
AWS_REGION=us-east-1
